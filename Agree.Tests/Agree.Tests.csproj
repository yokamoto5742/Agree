<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ローカルOracle Free (OraOLEDB.Oracle) に対する結合テスト。
    32bit の OraOLEDB プロバイダをロードするため x86 でビルド/実行する。
    System.Data.OleDb は .NET Framework 同梱のため PackageReference 不要。
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <!-- テストホストを x86 に固定（32bit OraOLEDB をロードするため）。 -->
    <RunSettingsFilePath>$(MSBuildProjectDirectory)\x86.runsettings</RunSettingsFilePath>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="AgentlabUtilityLibrary.ini" />
    <None Remove="x86.runsettings" />
  </ItemGroup>
  <ItemGroup>
    <!-- 認証情報を含むため git 管理外。無い環境（クローン直後など）でもビルドできるようにする。 -->
    <Content Include="AgentlabUtilityLibrary.ini" Condition="Exists('AgentlabUtilityLibrary.ini')">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    本体の純粋ロジックをソースリンクして単体テストする。
    COM(Excel) を巻き込まないよう、Agree.csproj 全体は参照せず、依存の無いファイルだけを取り込む。
  -->
  <ItemGroup>
    <Compile Include="..\Agree\AgreeSql.cs" Link="Linked\AgreeSql.cs" />
    <Compile Include="..\Agree\AppSettings.cs" Link="Linked\AppSettings.cs" />
    <Compile Include="..\Agree\Db.cs" Link="Linked\Db.cs" />
    <Compile Include="..\Agree\Ehr.cs" Link="Linked\Ehr.cs" />
    <Compile Include="..\Agree\Infrastructure\Barcode128.cs" Link="Linked\Barcode128.cs" />
    <Compile Include="..\Agree\Infrastructure\CharMap.cs" Link="Linked\CharMap.cs" />
    <Compile Include="..\Agree\Infrastructure\DBConn.cs" Link="Linked\DBConn.cs" />
    <Compile Include="..\Agree\Infrastructure\Enc.cs" Link="Linked\Enc.cs" />
    <Compile Include="..\Agree\Infrastructure\Env.cs" Link="Linked\Env.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
  </ItemGroup>

</Project>
