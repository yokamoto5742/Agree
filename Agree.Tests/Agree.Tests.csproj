<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ローカルOracle Free に対する結合テスト。
    ODP.NET マネージド・ドライバ（100%マネージド）を使うため、
    Oracle クライアントのインストールも 32bit プロバイダの登録も不要。
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <!-- マネージド・ドライバ自体は MSIL で x86 縛りは不要だが、本体が Excel COM の都合で
         x86 ビルドのため揃えておく。 -->
    <RunSettingsFilePath>$(MSBuildProjectDirectory)\x86.runsettings</RunSettingsFilePath>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="AgentlabUtilityLibrary.ini" />
    <None Remove="x86.runsettings" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="AgentlabUtilityLibrary.ini">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    本体の純粋ロジックをソースリンクして単体テストする。
    COM(Excel) / 外部DLL(AgentlabUtilityLibrary) を巻き込まないよう、
    Agree.csproj 全体は参照せず AgreeSql.cs 1ファイルだけを取り込む。
  -->
  <ItemGroup>
    <Compile Include="..\Agree\AgreeSql.cs" Link="Linked\AgreeSql.cs" />
  </ItemGroup>

  <!--
    本体と同一の DLL ファイルを参照する（PackageReference にしない）。
    こうしておくとアプリとテストでバージョンがズレないため bindingRedirect が不要。
  -->
  <ItemGroup>
    <Reference Include="Oracle.ManagedDataAccess">
      <HintPath>..\Oracle.ManagedDataAccess.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
  </ItemGroup>

</Project>
